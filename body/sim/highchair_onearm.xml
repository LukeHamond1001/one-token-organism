      <geom name="parent_torso" type="ellipsoid" pos="0 -0.03 0.07" size="0.125 0.094 0.175" material="shell" contype="0" conaffinity="0" density="0"/>
      <geom name="parent_charge_light" type="cylinder" pos="0 0.0556 0.15" euler="-90 0 0" size=".015 .003" material="charge" contype="0" conaffinity="0" density="0"/>
      <geom type="cylinder" pos="0 0.0526 0.15" euler="-90 0 0" size=".021 .004" material="joint" contype="0" conaffinity="0" density="0"/>
      <!-- the shoulder: a boom from the chest to the hub, in the arm's plane -->
      <geom name="parent_boom" type="capsule" fromto="0 0.04385 0.08 0 0.12 0.08" size=".024" material="joint" contype="1" conaffinity="1"/>
      <geom name="parent_hub" type="cylinder" pos="0 0.12 0.08" size=".032 .026" material="joint" contype="1" conaffinity="1"/>
      <geom type="cylinder" pos="0 0.12 0.107" size=".025 .002" material="accent_parent" contype="0" conaffinity="0" density="0"/>
      <!-- the arm: planar, two vertical hinges, links 0.22 and 0.19 m, 8 cm above the table -->
      <body name="parent_upper_arm" pos="0 0.12 0.08">
        <joint name="parent_shoulder" type="hinge" axis="0 0 1" range="-110 110" damping=".1" armature=".002"/>
        <geom name="parent_upper_arm" type="capsule" fromto="0 0 0 0 0.22 0" size=".018" mass=".3" material="shell" contype="1" conaffinity="1"/>
        <site name="parent_upper_arm_touch" type="capsule" fromto="0 0 0 0 0.22 0" size=".020" group="4"/>
        <body name="parent_forearm" pos="0 0.22 0">
          <joint name="parent_elbow" type="hinge" axis="0 0 1" range="-150 150" damping=".05" armature=".002"/>
          <geom type="cylinder" size=".025 .023" material="joint" contype="0" conaffinity="0" density="0"/>
          <geom name="parent_forearm" type="capsule" fromto="0 0 0 0 0.19 0" size=".016" mass=".2" material="shell" contype="1" conaffinity="1"/>
          <site name="parent_forearm_touch" type="capsule" fromto="0 0 0 0 0.19 0" size=".018" group="4"/>
          <site name="parent_forearm_hold" pos="0 0.15 0" size=".006" group="4"/>
          <!-- the mitten: dark, downward, with the touch sensor and the adhesion grip -->
          <body name="parent_hand" pos="0 0.19 0">
            <geom name="parent_mitten" type="capsule" fromto="0 0 0 0 0 -0.052" size="0.022" mass=".05" material="mitten" friction="1 .005 .0001" contype="1" conaffinity="1"/>
            <geom type="cylinder" pos="0 0 .006" size=".0245 .006" material="accent_parent" contype="0" conaffinity="0" density="0"/>
            <site name="parent_mitten_touch" type="capsule" fromto="0 0 0 0 0 -0.052" size="0.024" group="4"/>
          </body>
        </body>
      </body>
      <!-- the head: pan at the neck, tilt at the head's centre, 0.36 m above the table -->
      <geom name="parent_collar" type="mesh" mesh="collar" pos="0 -0.015 0.241" material="accent_parent" contype="0" conaffinity="0" density="0"/>
      <body name="parent_neck" pos="0 0 .27">
        <joint name="parent_pan" type="hinge" axis="0 0 1" range="-60 60" damping=".05" armature=".0005"/>
        <geom type="cylinder" pos="0 0 .012" size=".028 .026" mass=".05" material="joint" contype="0" conaffinity="0"/>
        <body name="parent_head" pos="0 0 0.09" gravcomp="1">
          <joint name="parent_tilt" type="hinge" axis="1 0 0" range="-75 20" damping=".05" armature=".0005"/>
          <geom name="parent_head" type="mesh" mesh="head" material="shell" mass=".2" contype="0" conaffinity="0"/>
          <!-- the face: a dark screen in a white frame, two lit eyes, a mouth whose curvature is the parent_face actuator
               (a fixed centre bar and two capsules hinged at its ends, turning up for a smile, down for a frown) -->
          <geom name="parent_bezel" type="mesh" mesh="bezel" pos="0 .066 .002" material="shell" contype="0" conaffinity="0" density="0"/>
          <geom name="parent_screen" type="mesh" mesh="screen" pos="0 0.071 .002" material="screen" contype="0" conaffinity="0" density="0"/>
          <geom name="parent_eye_L" type="ellipsoid" pos="-.029 0.0795 0.016" size=".0115 .0028 .0155" material="glow" contype="0" conaffinity="0" density="0"/>
          <geom name="parent_eye_R" type="ellipsoid" pos=".029 0.0795 0.016" size=".0115 .0028 .0155" material="glow" contype="0" conaffinity="0" density="0"/>
          <geom name="parent_mouth_mid" type="capsule" fromto="-.010 0.08 -.023 .010 0.08 -.023" size=".006" material="glow" contype="0" conaffinity="0" density="0"/>
          <body name="parent_mouth_L" pos="-.010 0.08 -.023" gravcomp="1">
            <joint name="parent_mouth" type="hinge" axis="0 1 0" range="-35 35" damping=".0015" armature=".0001"/>
            <geom name="parent_mouth_L" type="capsule" fromto="0 0 0 -.019 0 0" size=".006" material="glow" mass=".001" contype="0" conaffinity="0"/>
          </body>
          <body name="parent_mouth_R" pos=".010 0.08 -.023" gravcomp="1">
            <joint name="parent_mouth_R" type="hinge" axis="0 1 0" range="-35 35" damping=".0015" armature=".0001"/>
            <geom name="parent_mouth_R" type="capsule" fromto="0 0 0 .019 0 0" size=".006" material="glow" mass=".001" contype="0" conaffinity="0"/>
          </body>
          <!-- two ears, left and right (the ear sites are where each ear hears from) -->
          <geom name="parent_ear_L" type="capsule" fromto="-0.087 0 -.02 -0.087 0 .02" size=".0105" material="accent_parent" contype="0" conaffinity="0" density="0"/>
          <geom name="parent_ear_R" type="capsule" fromto="0.087 0 -.02 0.087 0 .02" size=".0105" material="accent_parent" contype="0" conaffinity="0" density="0"/>
          <site name="parent_ear_L" pos="-0.099 0 0" size=".006" group="4"/>
          <site name="parent_ear_R" pos="0.099 0 0" size=".006" group="4"/>
          <!-- the eye: one camera between the drawn eyes; render 128 px -> periphery 64 px + fovea (centre 32 px) -->
          <camera name="parent_eye" pos="0 0.0815 0.016" xyaxes="1 0 0 0 0 1" fovy="60"/>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- the shoulder's hub and boom (on the fixed base) are solid for objects, but the upper arm turns inside the hub -->
    <exclude body1="child_base" body2="child_upper_arm"/>
    <exclude body1="parent_base" body2="parent_upper_arm"/>
  </contact>

  <equality>
    <!-- each mouth is one curvature: the right half mirrors the left (face ctrl > 0 smiles, < 0 frowns) -->
    <joint name="child_mouth_mirror" joint1="child_mouth_R" joint2="child_mouth" polycoef="0 -1 0 0 0" solref=".005 1"/>
    <joint name="parent_mouth_mirror" joint1="parent_mouth_R" joint2="parent_mouth" polycoef="0 -1 0 0 0" solref=".005 1"/>
    <!-- the parent's guiding hand on the child's forearm: a soft weld at the forearm's hold point (site child_forearm_hold,
         0.15 m from the elbow), off until the teacher guides. torquescale 0: it holds the point, never the forearm's angle.
         Switch it on only with make_highchair_onearm.guide(m, d), which writes the offset from the current pose (the compiled
         offset, from qpos0, is meaningless). Its constraint force is not a contact, so it never reads as touch or pain. -->
    <weld name="parent_guides_child" body1="parent_hand" body2="child_forearm" anchor="0 0.15 0" torquescale="0" active="false" solref=".05 1"/>
  </equality>

  <actuator>
    <!-- child: position servos (the servo law sets target = measured angle + step each tick). Measured on this file 2026-09-24,
         from rest: an arm step of 0.27 or 0.09 rad is at 103% after one 150 ms tick (peak overshoot 4-6%); a gaze step of 0.2 or
         0.07 rad at 101-102% (overshoot under 2%); the face at 97% (overshoot 1.5%). The torque limits
         are the declared limits the charge drain is capped by and weakness scales ((0.3 + 0.7h) x forcerange);
         declared stall force at the mitten: 1.2 N m / 0.41 m = 2.9 N (shoulder), 0.8 N m / 0.19 m = 4.2 N (elbow) -->
    <position name="child_shoulder" joint="child_shoulder" kp="15" kv=".6" ctrlrange="-1.9199 1.9199" forcelimited="true" forcerange="-1.2 1.2"/>
    <position name="child_elbow" joint="child_elbow" kp="10" kv=".3" ctrlrange="-2.6180 2.6180" forcelimited="true" forcerange="-0.8 0.8"/>
    <adhesion name="child_grip" body="child_hand" ctrlrange="0 1" gain="3"/>
    <position name="child_pan" joint="child_pan" kp="1.5" kv=".02" ctrlrange="-1.0472 1.0472"/>
    <position name="child_tilt" joint="child_tilt" kp="1.5" kv=".02" ctrlrange="-1.3090 0.3491"/>
    <position name="child_face" joint="child_mouth" kp=".12" kv=".005" ctrlrange="-.6 .6"/>

    <!-- parent: position servos (the servo law sets target = measured angle + step each tick). Measured on this file 2026-09-24,
         from rest: an arm step of 0.27 or 0.09 rad is at 103% after one 150 ms tick (peak overshoot 4-6%); a gaze step of 0.2 or
         0.07 rad at 101-102% (overshoot under 2%); the face at 97% (overshoot 1.5%). The torque limits
         are the declared limits the charge drain is capped by and weakness scales ((0.3 + 0.7h) x forcerange);
         declared stall force at the mitten: 1.2 N m / 0.41 m = 2.9 N (shoulder), 0.8 N m / 0.19 m = 4.2 N (elbow) -->
    <position name="parent_shoulder" joint="parent_shoulder" kp="15" kv=".6" ctrlrange="-1.9199 1.9199" forcelimited="true" forcerange="-1.2 1.2"/>
    <position name="parent_elbow" joint="parent_elbow" kp="10" kv=".3" ctrlrange="-2.6180 2.6180" forcelimited="true" forcerange="-0.8 0.8"/>
    <adhesion name="parent_grip" body="parent_hand" ctrlrange="0 1" gain="3"/>
    <position name="parent_pan" joint="parent_pan" kp="1.5" kv=".02" ctrlrange="-1.0472 1.0472"/>
    <position name="parent_tilt" joint="parent_tilt" kp="1.5" kv=".02" ctrlrange="-1.3090 0.3491"/>
    <position name="parent_face" joint="parent_mouth" kp=".12" kv=".005" ctrlrange="-.6 .6"/>
  </actuator>

  <sensor>
    <touch name="child_touch" site="child_mitten_touch"/>
    <touch name="child_upper_arm_touch" site="child_upper_arm_touch"/><touch name="child_forearm_touch" site="child_forearm_touch"/>
    <jointpos name="child_shoulder_pos" joint="child_shoulder"/><jointpos name="child_elbow_pos" joint="child_elbow"/>
    <jointvel name="child_shoulder_vel" joint="child_shoulder"/><jointvel name="child_elbow_vel" joint="child_elbow"/>
    <jointpos name="child_pan_pos" joint="child_pan"/><jointpos name="child_tilt_pos" joint="child_tilt"/>
    <jointvel name="child_pan_vel" joint="child_pan"/><jointvel name="child_tilt_vel" joint="child_tilt"/>
    <actuatorfrc name="child_shoulder_torque" actuator="child_shoulder"/><actuatorfrc name="child_elbow_torque" actuator="child_elbow"/>

    <touch name="parent_touch" site="parent_mitten_touch"/>
    <touch name="parent_upper_arm_touch" site="parent_upper_arm_touch"/><touch name="parent_forearm_touch" site="parent_forearm_touch"/>
    <jointpos name="parent_shoulder_pos" joint="parent_shoulder"/><jointpos name="parent_elbow_pos" joint="parent_elbow"/>
    <jointvel name="parent_shoulder_vel" joint="parent_shoulder"/><jointvel name="parent_elbow_vel" joint="parent_elbow"/>
    <jointpos name="parent_pan_pos" joint="parent_pan"/><jointpos name="parent_tilt_pos" joint="parent_tilt"/>
    <jointvel name="parent_pan_vel" joint="parent_pan"/><jointvel name="parent_tilt_vel" joint="parent_tilt"/>
    <actuatorfrc name="parent_shoulder_torque" actuator="parent_shoulder"/><actuatorfrc name="parent_elbow_torque" actuator="parent_elbow"/>
  </sensor>

